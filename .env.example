# Copie para .env e ajuste. Nenhum valor abaixo é um segredo real.

# SQLite do hospital mock. Default Colab preservado se omitido.
HOSPITAL_DB_PATH=

# Base do Google Drive (adapter LoRA). Default Colab se omitido.
DRIVE_BASE=

# Token Hugging Face (perfil full-gpu). Deixe vazio nos perfis ml-only/demo-cpu.
HF_TOKEN=

# ml-only | demo-cpu | full-gpu
PERFIL_EXECUCAO=ml-only

# 0 = obstétrico idêntico à Fase 3; 1 = nó ML opcional
ML_RISCO_HABILITADO=0

# Diretório de artefatos (dataset, modelos, métricas)
ARTIFACTS_DIR=

# Reprodutibilidade
RANDOM_SEED=42
DATASET_VERSION=v1.0.0
