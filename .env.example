# Copie para .env e ajuste. Nenhum valor abaixo é um segredo real.

# SQLite do hospital mock. Vazio no perfil full = files/hospital.db na raiz do repositório.
# Os notebooks seguem o default do Colab. No compose full: /app/files/hospital.db
HOSPITAL_DB_PATH=

# Base do Google Drive, só para os notebooks. Deixe vazio fora do Colab.
DRIVE_BASE=

# Token Hugging Face (perfil full-gpu / Docker full). Deixe vazio nos perfis ml-only/demo-cpu.
# A conta precisa ter a licença do meta-llama/Llama-3.2-3B-Instruct aceita.
HF_TOKEN=

# Índice Chroma. Vazio = files/chroma. No compose full: /app/files/chroma
CHROMA_PATH=

# Pasta adapter_final ou o diretório das runs. Vazio = files/finetune (run mais recente).
# No compose full: /app/files/finetune
ADAPTER_DIR=

# 1 = 4-bit se houver GPU; 0 = pesos completos; vazio = 4-bit só quando CUDA existir.
USE_4BIT=

# ml-only | demo-cpu | full-gpu
PERFIL_EXECUCAO=ml-only

# 0 = obstétrico sem o nó de ML; 1 = nó ML opcional
ML_RISCO_HABILITADO=0

# Diretório de artefatos (dataset, modelos, métricas)
ARTIFACTS_DIR=

# Reprodutibilidade
RANDOM_SEED=42
DATASET_VERSION=v1.0.0
